+#include <stdarg.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "objbase.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(mscorwks);
+
+/***********************************************************************
+ * DllCanUnloadNowInternal (mscorwks.@)
+ *
+ * Native CLR never unloads once loaded.
+ */
+HRESULT WINAPI DllCanUnloadNowInternal(void)
+{
+    return S_FALSE;
+}
+
+/***********************************************************************
+ * DllGetClassObjectInternal (mscorwks.@)
+ */
+HRESULT WINAPI DllGetClassObjectInternal(REFCLSID clsid, REFIID iid, void **obj)
+{
+    TRACE("(%s, %s, %p)\n", debugstr_guid(clsid), debugstr_guid(iid), obj);
+    if (obj) *obj = NULL;
+    return CLASS_E_CLASSNOTAVAILABLE;
+}
+
+/***********************************************************************
+ * DllRegisterServerInternal (mscorwks.@)
+ *
+ * Called by native mscoree/mscoreei during wineboot INF registration
+ * (and by the .NET installer). Desktop CLR / CoreCLR treat this as a
+ * no-op that returns S_OK; crashing here starts winedbg on every prefix
+ * update when *mscoree=native.
+ */
+HRESULT WINAPI DllRegisterServerInternal(HINSTANCE hmod, const WCHAR *version)
+{
+    TRACE("(%p, %s)\n", hmod, debugstr_w(version));
+    return S_OK;
+}
+
+/***********************************************************************
+ * DllUnregisterServerInternal (mscorwks.@)
+ */
+HRESULT WINAPI DllUnregisterServerInternal(void)
+{
+    TRACE("()\n");
+    return S_OK;
+}
+
+/***********************************************************************
+ * EEDllRegisterServer (mscorwks.@)
+ */
+HRESULT WINAPI EEDllRegisterServer(const WCHAR *arg)
+{
+    TRACE("(%s)\n", debugstr_w(arg));
+    return S_OK;
+}
+
+/***********************************************************************
+ * EEDllUnregisterServer (mscorwks.@)
+ */
+HRESULT WINAPI EEDllUnregisterServer(const WCHAR *arg)
+{
+    TRACE("(%s)\n", debugstr_w(arg));
+    return S_OK;
+}
